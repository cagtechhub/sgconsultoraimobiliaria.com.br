generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/prisma/output"
}

datasource db {
  provider = "postgresql"
  schemas  = ["gutierres"]
}

enum PropertyStatus {
  LAUNCH
  UNDER_CONSTRUCTION
  READY

  @@map("property_status")
  @@schema("gutierres")
}

enum LeadChannel {
  WEBSITE
  ADSENSE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  REFERRAL
  OTHER

  @@map("lead_channel")
  @@schema("gutierres")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST

  @@map("lead_status")
  @@schema("gutierres")
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT

  @@map("media_kind")
  @@schema("gutierres")
}

model Contact {
  id        String   @id @default(cuid())
  fullName  String   @map("full_name")
  email     String
  phone     String?
  message   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  leads     Lead[]

  @@index([email])
  @@map("contacts")
  @@schema("gutierres")
}

model PropertyCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0) @map("sort_order")
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  properties  Property[]

  @@index([active])
  @@index([sortOrder])
  @@map("property_categories")
  @@schema("gutierres")
}

model Property {
  id                    String            @id @default(cuid())
  slug                  String            @unique
  title                 String
  description           String
  longDescription       String            @default("") @map("long_description")
  location              String            @default("")
  status                PropertyStatus    @default(LAUNCH)
  constructionStartDate DateTime?         @map("construction_start_date")
  constructionEndDate   DateTime?         @map("construction_end_date")
  availableUnits        Int               @default(0) @map("available_units")
  progress              Int               @default(0)
  highlights            Json              @default("[]")
  floorPlanUrl          String?           @map("floor_plan_url")
  featured              Boolean           @default(false)
  selectedOnHome        Boolean           @default(false) @map("selected_on_home")
  published             Boolean           @default(true)
  categoryId            String?           @map("category_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  category              PropertyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media                 PropertyMedia[]
  leads                 Lead[]

  @@index([status])
  @@index([published])
  @@index([featured])
  @@index([selectedOnHome])
  @@index([categoryId])
  @@map("properties")
  @@schema("gutierres")
}

model PropertyMedia {
  id          String    @id @default(cuid())
  propertyId  String    @map("property_id")
  url         String
  storagePath String    @map("storage_path")
  kind        MediaKind @default(IMAGE)
  mimeType    String    @map("mime_type")
  fileName    String    @map("file_name")
  sortOrder   Int       @default(0) @map("sort_order")
  isCover     Boolean   @default(false) @map("is_cover")
  createdAt   DateTime  @default(now()) @map("created_at")
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([isCover])
  @@map("property_media")
  @@schema("gutierres")
}

model Lead {
  id         String      @id @default(cuid())
  fullName   String      @map("full_name")
  email      String?
  phone      String?
  notes      String?
  channel    LeadChannel @default(WEBSITE)
  status     LeadStatus  @default(NEW)
  contactId  String?     @map("contact_id")
  propertyId String?     @map("property_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  property   Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([channel])
  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("leads")
  @@schema("gutierres")
}

model SiteSettings {
  id                String   @id @default(cuid())
  siteUrl           String   @default("") @map("site_url")
  siteName          String   @default("Stefanny Gutierres") @map("site_name")
  seoLocality       String   @default("Brasil") @map("seo_locality")
  noIndex           Boolean  @default(false) @map("no_index")
  businessAddress   String   @default("") @map("business_address")
  businessPhone     String   @default("") @map("business_phone")
  contactEmail      String   @default("") @map("contact_email")
  whatsappNumber    String   @default("") @map("whatsapp_number")
  whatsappMessage   String   @default("") @map("whatsapp_message")
  instagramUrl      String   @default("") @map("instagram_url")
  facebookUrl       String   @default("") @map("facebook_url")
  linkedinUrl       String   @default("") @map("linkedin_url")
  defaultOgImageUrl String   @default("") @map("default_og_image_url")
  ga4MeasurementId  String   @default("") @map("ga4_measurement_id")
  metaPixelId       String   @default("") @map("meta_pixel_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
  @@schema("gutierres")
}

model SoldCase {
  id               String    @id @default(cuid())
  propertyTitle    String    @map("property_title")
  location         String    @default("")
  coverUrl         String?   @map("cover_url")
  coverStoragePath String?   @map("cover_storage_path")
  clientName       String    @map("client_name")
  clientRole       String    @default("") @map("client_role")
  quote            String
  soldAt           DateTime? @map("sold_at")
  sortOrder        Int       @default(0) @map("sort_order")
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([active])
  @@index([sortOrder])
  @@map("sold_cases")
  @@schema("gutierres")
}

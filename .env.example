# Copie para `.env` só na VPS. Não commitar segredos.

DOMAIN=gutierresconsultoria.com.br
API_DOMAIN=api.gutierresconsultoria.com.br
# DNS no Cloudflare (Proxied / nuvem laranja): A/AAAA iguais para apex, www e API_DOMAIN.
# SSL/TLS no Cloudflare: Full (strict). Origin CA no Traefik da OS (sem Let's Encrypt nestes routers).
# NUXT_PUBLIC_SITE_URL = canônico sem www.

TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
# Sem TRAEFIK_CERT_RESOLVER: HTTP-01 + proxy laranja quebra. tls=true usa o Origin CA default.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=gutierres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=properties
# ADMIN_ALLOWED_EMAILS=admin@gutierresconsultoria.com.br
# ADMIN_REQUIRE_ROLE=true

NUXT_PUBLIC_API_BASE=https://api.gutierresconsultoria.com.br
NUXT_PUBLIC_SITE_URL=https://gutierresconsultoria.com.br
NUXT_PUBLIC_SITE_NAME=Gutierres Consultoria
NUXT_PUBLIC_NO_INDEX=false
NUXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SSR (Compose): NUXT_API_BASE=http://gutierresconsultoria-backend:3001
# Não usar http://backend:3001 — colide com outros apps na rede Traefik `web`.
